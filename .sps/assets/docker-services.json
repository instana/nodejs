{
  "sidecars": [
    {
      "name": "mysql",
      "image": "mirror.gcr.io/library/mysql:8.0.26",
      "env": [
        {
          "name": "MYSQL_ROOT_PASSWORD",
          "value": "nodepw"
        },
        {
          "name": "MYSQL_DATABASE",
          "value": "nodedb"
        },
        {
          "name": "MYSQL_USER",
          "value": "node"
        },
        {
          "name": "MYSQL_PASSWORD",
          "value": "nodepw"
        },
        {
          "name": "MYSQL_ROOT_HOST",
          "value": "0.0.0.0"
        }
      ],
      "args": ["--default-authentication-plugin=mysql_native_password"],
      "readinessProbe": {
        "exec": {
          "command": ["sh", "-c", "mysql -h 0.0.0.0 -u node -p'nodepw' -e 'SELECT 1'"]
        },
        "initialDelaySeconds": 3,
        "periodSeconds": 2,
        "timeoutSeconds": 10
      }
    },
    {
      "name": "oracledb",
      "image": "mirror.gcr.io/gvenzl/oracle-free:23-slim",
      "preStart": true,
      "env": [
        {
          "name": "ORACLE_PASSWORD",
          "value": "teamnodejspassword"
        }
      ]
    },
    {
      "name": "mongodb",
      "image": "mirror.gcr.io/library/mongo:8.0.8"
    },
    {
      "name": "zookeeper",
      "image": "mirror.gcr.io/confluentinc/cp-zookeeper:7.9.4",
      "env": [
        {
          "name": "ZOOKEEPER_CLIENT_PORT",
          "value": "2181"
        }
      ],
      "readinessProbe": {
        "tcpSocket": {
          "port": 2181
        },
        "initialDelaySeconds": 5,
        "periodSeconds": 2,
        "timeoutSeconds": 30
      }
    },
    {
      "name": "kafka",
      "image": "mirror.gcr.io/confluentinc/cp-kafka:7.9.4",
      "env": [
        {
          "name": "KAFKA_BROKER_ID",
          "value": "1"
        },
        {
          "name": "KAFKA_ZOOKEEPER_CONNECT",
          "value": "localhost:2181"
        },
        {
          "name": "KAFKA_ADVERTISED_LISTENERS",
          "value": "PLAINTEXT://127.0.0.1:29092,EXTERNAL://localhost:9092"
        },
        {
          "name": "KAFKA_LISTENERS",
          "value": "EXTERNAL://:9092,PLAINTEXT://:29092"
        },
        {
          "name": "KAFKA_OFFSETS_TOPIC_REPLICATION_FACTOR",
          "value": "1"
        },
        {
          "name": "KAFKA_DEFAULT_REPLICATION_FACTOR",
          "value": "1"
        },
        {
          "name": "KAFKA_LISTENER_SECURITY_PROTOCOL_MAP",
          "value": "PLAINTEXT:PLAINTEXT,PLAINTEXT_HOST:PLAINTEXT,EXTERNAL:PLAINTEXT"
        }
      ],
      "readinessProbe": {
        "tcpSocket": {
          "port": 9092
        },
        "initialDelaySeconds": 90,
        "periodSeconds": 2,
        "timeoutSeconds": 60
      }
    },
    {
      "name": "kafka-topics",
      "image": "mirror.gcr.io/confluentinc/cp-kafka:7.9.4",
      "command": ["/bin/bash"],
      "args": [
        "-lc",
        "kafka_server=\"0.0.0.0:9092\"; kafka_topics=\"test test-topic test-batch-topic rdkafka-topic confluent-kafka-topic\"; until kafka-topics --bootstrap-server \"$kafka_server\" --list >/dev/null 2>&1; do echo 'waiting for Kafka...'; sleep 2; done; for t in $kafka_topics; do kafka-topics --bootstrap-server \"$kafka_server\" --create --if-not-exists --topic \"$t\"; done; echo 'All topics created.'"
      ]
    },
    {
      "name": "postgres",
      "image": "mirror.gcr.io/library/postgres:15.15",
      "env": [
        {
          "name": "POSTGRES_USER",
          "value": "node"
        },
        {
          "name": "POSTGRES_PASSWORD",
          "value": "nodepw"
        },
        {
          "name": "POSTGRES_DB",
          "value": "nodedb"
        }
      ],
      "readinessProbe": {
        "exec": {
          "command": ["sh", "-c", "pg_isready --host 127.0.0.1 --port 5432 --dbname=nodedb"]
        },
        "initialDelaySeconds": 5,
        "periodSeconds": 2,
        "timeoutSeconds": 60
      }
    },
    {
      "name": "rabbitmq",
      "image": "mirror.gcr.io/library/rabbitmq:3.13.0",
      "readinessProbe": {
        "tcpSocket": {
          "port": 5672
        },
        "initialDelaySeconds": 7,
        "periodSeconds": 2,
        "timeoutSeconds": 60
      }
    },
    {
      "name": "redis",
      "image": "mirror.gcr.io/library/redis:7.4.3"
    },
    {
      "name": "redis-slave",
      "image": "mirror.gcr.io/library/redis:7.4.3",
      "args": ["redis-server", "--replicaof", "127.0.0.1", "6379", "--port", "6380"]
    },
    {
      "name": "redis-sentinel",
      "image": "mirror.gcr.io/library/redis:7.4.3",
      "args": [
        "sh",
        "-c",
        "echo \"sentinel monitor mymaster 127.0.0.1 6379 2\" > /etc/sentinel.conf && echo \"sentinel down-after-milliseconds mymaster 1000\" >> /etc/sentinel.conf && echo \"sentinel failover-timeout mymaster 5000\" >> /etc/sentinel.conf && echo \"sentinel parallel-syncs mymaster 1\" >> /etc/sentinel.conf && echo \"sentinel resolve-hostnames no\" >> /etc/sentinel.conf && redis-server /etc/sentinel.conf --sentinel --port 26379"
      ]
    },
    {
      "name": "redis-cluster",
      "image": "mirror.gcr.io/library/redis:7.4.3",
      "command": ["sh"],
      "args": [
        "-c",
        "redis-server --port 7000 --cluster-enabled yes --cluster-config-file nodes-7000.conf --cluster-node-timeout 5000 --appendonly no --daemonize yes && redis-server --port 7001 --cluster-enabled yes --cluster-config-file nodes-7001.conf --cluster-node-timeout 5000 --appendonly no --daemonize yes && redis-server --port 7002 --cluster-enabled yes --cluster-config-file nodes-7002.conf --cluster-node-timeout 5000 --appendonly no --daemonize yes && sleep 1 && echo 'yes' | redis-cli --cluster create 127.0.0.1:7000 127.0.0.1:7001 127.0.0.1:7002 --cluster-replicas 0 && tail -f /dev/null"
      ],
      "readinessProbe": {
        "exec": {
          "command": ["sh", "-c", "redis-cli -p 7000 cluster info | grep -q 'cluster_state:ok'"]
        },
        "initialDelaySeconds": 2,
        "periodSeconds": 1,
        "timeoutSeconds": 30
      }
    },
    {
      "name": "localstack",
      "image": "mirror.gcr.io/localstack/localstack:4.5",
      "volumes": ["/var/run/docker.sock:/var/run/docker.sock"]
    },
    {
      "name": "azurite",
      "image": "mcr.microsoft.com/azure-storage/azurite:3.37.0",
      "args": [
        "azurite",
        "--blobHost",
        "0.0.0.0",
        "--queueHost",
        "0.0.0.0",
        "--tableHost",
        "0.0.0.0",
        "--loose",
        "--inMemoryPersistence"
      ],
      "env": [
        {
          "name": "AZURITE_ACCOUNTS",
          "value": "devstoreaccount1:Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OceiPiBeEEiypt/RI7k9g4Vm0J8SeBLMYxPTLr8GlFocl2qSA1dV5w=="
        }
      ],
      "readinessProbe": {
        "tcpSocket": {
          "port": 10000
        },
        "initialDelaySeconds": 3,
        "periodSeconds": 2,
        "timeoutSeconds": 30
      }
    },
    {
      "name": "memcached",
      "image": "mirror.gcr.io/library/memcached:1.6.9"
    },
    {
      "name": "nats",
      "image": "mirror.gcr.io/library/nats:2.9.14-linux"
    },
    {
      "name": "nats-streaming",
      "image": "mirror.gcr.io/library/nats-streaming:0.25.3-linux",
      "args": ["-p", "4223", "-m", "8223"],
      "readinessProbe": {
        "httpGet": {
          "path": "/healthz",
          "port": 8223
        },
        "initialDelaySeconds": 5,
        "periodSeconds": 2,
        "timeoutSeconds": 15
      }
    },
    {
      "name": "nats-streaming-2",
      "image": "mirror.gcr.io/library/nats-streaming:0.25.3-linux",
      "args": ["-p", "4224", "-m", "8224"],
      "readinessProbe": {
        "httpGet": {
          "path": "/healthz",
          "port": 8224
        },
        "initialDelaySeconds": 5,
        "periodSeconds": 2,
        "timeoutSeconds": 15
      }
    },
    {
      "name": "elasticsearch",
      "image": "mirror.gcr.io/elastic/elasticsearch:9.0.0",
      "env": [
        {
          "name": "discovery.type",
          "value": "single-node"
        },
        {
          "name": "ES_JAVA_OPTS",
          "value": "-Xms500m -Xmx500m"
        },
        {
          "name": "xpack.security.enabled",
          "value": "false"
        }
      ]
    },
    {
      "name": "couchbase",
      "image": "mirror.gcr.io/library/couchbase:7.6.7",
      "readinessProbe": {
        "httpGet": {
          "path": "/",
          "port": 8091
        },
        "initialDelaySeconds": 15,
        "periodSeconds": 2,
        "timeoutSeconds": 60
      }
    },
    {
      "name": "pubsub-emulator",
      "image": "gcr.io/google.com/cloudsdktool/google-cloud-cli:emulators",
      "command": ["gcloud"],
      "args": ["beta", "emulators", "pubsub", "start", "--host-port=0.0.0.0:8085", "--project=test-project"],
      "readinessProbe": {
        "tcpSocket": {
          "port": 8085
        },
        "initialDelaySeconds": 5,
        "periodSeconds": 2,
        "timeoutSeconds": 30
      }
    },
    {
      "name": "fake-gcs-server",
      "image": "mirror.gcr.io/fsouza/fake-gcs-server:1.52.2",
      "args": ["-scheme", "http", "-port", "4443", "-public-host", "127.0.0.1:4443"],
      "readinessProbe": {
        "httpGet": {
          "path": "/storage/v1/b",
          "port": 4443
        },
        "initialDelaySeconds": 2,
        "periodSeconds": 2,
        "timeoutSeconds": 15
      }
    },
    {
      "name": "ibm_db",
      "image": "icr.io/db2_community/db2:12.1.5.0",
      "platform": "linux/amd64",
      "privileged": true,
      "tmpfs": ["/database:uid=1000,gid=1000"],
      "ports": ["58885:50000"],
      "env": [
        {
          "name": "PERSISTENT_HOME",
          "value": "false"
        },
        {
          "name": "DBNAME",
          "value": "nodedb"
        },
        {
          "name": "BLU",
          "value": "false"
        },
        {
          "name": "HADR_ENABLED",
          "value": "false"
        },
        {
          "name": "ENABLE_ORACLE_COMPATIBILITY",
          "value": "false"
        },
        {
          "name": "UPDATEAVAIL",
          "value": "NO"
        },
        {
          "name": "SAMPLEDB",
          "value": "false"
        },
        {
          "name": "REPODB",
          "value": "false"
        },
        {
          "name": "IS_OSXFS",
          "value": "false"
        },
        {
          "name": "LICENSE",
          "value": "accept"
        },
        {
          "name": "DB2INSTANCE",
          "value": "node"
        },
        {
          "name": "DB2INST1_PASSWORD",
          "value": "nodepw"
        },
        {
          "name": "DB2_CREATE_DB_ON_PATH",
          "value": "true"
        },
        {
          "name": "STARTUP_MODE",
          "value": "restoreIfNotExists"
        }
      ]
    },
    {
      "name": "mssql",
      "image": "mcr.microsoft.com/azure-sql-edge:1.0.7",
      "env": [
        {
          "name": "ACCEPT_EULA",
          "value": "Y"
        },
        {
          "name": "MSSQL_SA_PASSWORD",
          "value": "stanCanHazMsSQL1"
        }
      ]
    }
  ]
}
